# ==============================================================================
# FASTCDN PRO & MEDIACMS - TEMPLATE DE CONFIGURAÇÃO DE AMBIENTE (.env.example)
# ==============================================================================

# Chave de API Mestre (Master API Key)
VITE_DEFAULT_API_KEY=fcdn_live_your_master_key_here

# URL Base da API FastCDN
VITE_FASTCDN_API_URL=https://fastcdn.fit

# Identidade Visual & Branding
VITE_APP_NAME=POS TV - Painel de Gestão
VITE_APP_SHORT_NAME=POS TV
VITE_APP_VERSION=2.5.0
VITE_LOGO_TEXT=POS TV
VITE_LOGO_ICON=▶
VITE_LOGO_GRADIENT_FROM=#E91E63
VITE_LOGO_GRADIENT_TO=#9C27B0

# Parâmetros de Servidor e Catálogo
VITE_DEFAULT_SERVER_NAME=FastCDN Edge Cloud VIP
VITE_DEFAULT_BOUQUET_ID=bq_completo
VITE_DEFAULT_BOUQUET_NAME=COMPLETO C/ ADULTOS
VITE_DEFAULT_TEST_HOURS=4
VITE_CURRENCY_SYMBOL=R$
VITE_DEFAULT_DNS=posserverativo.xyz
VITE_PANEL_URL=https://fastcdn.fit

# Credenciais Padrão do Administrador Master
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=admin123
